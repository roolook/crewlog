# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never expose to the browser. Used by the ops console + intake.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Used by `npm run db:link`
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical origin, used to build magic-link + invite URLs in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails allowed into /ops. Anyone else gets a 404.
OPERATOR_EMAILS=you@example.com

# ── Payments (stub) ───────────────────────────────────────────────────────────
# The Activate button on /preview/[slug] links here. Leave blank to use the
# built-in simulated activation (marks the tenant active without charging).
STRIPE_PAYMENT_LINK=
NEXT_PUBLIC_SETUP_FEE=99
NEXT_PUBLIC_MONTHLY_FEE=10

# ── Email (stub) ──────────────────────────────────────────────────────────────
# Every transactional email is rendered and written to the `email_log` table.
# Set EMAIL_PROVIDER=resend and add a key to also deliver them for real.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM_BUILD=build@crewlog.app
EMAIL_FROM_LOG=log@crewlog.app
