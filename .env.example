# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Never expose to the browser. Used by the ops console + intake.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Used by `npm run db:link`
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical origin, used to build magic-link + invite URLs in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails allowed into /ops. Anyone else gets a 404.
OPERATOR_EMAILS=you@example.com

# ── Payments (stub) ───────────────────────────────────────────────────────────
# The Activate button on /preview/[slug] links here. Leave blank to use the
# built-in simulated activation (marks the tenant active without charging).
STRIPE_PAYMENT_LINK=
NEXT_PUBLIC_SETUP_FEE=99
NEXT_PUBLIC_MONTHLY_FEE=10
NEXT_PUBLIC_CUSTOM_SETUP_FEE=299

# ── Email ─────────────────────────────────────────────────────────────────────
# Every transactional email is always rendered and written to the `email_log`
# table and shown at /ops/emails, whatever else is configured here.
#
#   log     nothing is delivered; /ops/emails is the outbox
#   resend  delivered through Resend
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Resend's shared sandbox sender. Needs no DNS setup, but it can ONLY deliver to
# the email address on your Resend account — every other recipient gets a 403.
# Once you own a domain, verify it in Resend and change these to build@ and log@
# your-domain.com.
EMAIL_FROM_BUILD=CrewLog <onboarding@resend.dev>
EMAIL_FROM_LOG=CrewLog <onboarding@resend.dev>

# Where replies go, regardless of which domain sent the mail.
EMAIL_REPLY_TO=build@crewlog.app

# The sandbox workaround: set this to your Resend account address and EVERY
# email is redirected there, with the real recipient kept in the subject line
# and a banner in the body. Lets you walk the whole funnel and actually receive
# the customer-facing mail. Leave blank once a domain is verified.
EMAIL_TEST_INBOX=

# ── Maps (optional) ───────────────────────────────────────────────────────────
# Needed only by the `location` field type. Create a free key at maptiler.com and
# restrict it to your domain. Without it the location field still captures the
# phone's GPS and hands off to the native map app — it just can't draw tiles.
NEXT_PUBLIC_MAPTILER_KEY=
